# MedAI Backend — Environment Configuration
# Copy this file to .env and fill in your values.

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME
#
# Docker Compose:      DATABASE_URL=postgresql://medai:medaipass@db/medai
# macOS Homebrew (no password): DATABASE_URL=postgresql://YOUR_OS_USER@localhost/medai
# Linux / Docker:      DATABASE_URL=postgresql://medai:medaipass@localhost/medai
DATABASE_URL=postgresql://postgres:postgres@localhost/medai

# Comma-separated allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend bind settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# JWT — generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
