# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ────────────────────────────────────────────
venv/
env/
.venv/
.env_python/

# ── Environment / secrets ───────────────────────────────────────────
.env
# Keep the example and the Docker-compose helper:
!.env.example

# ── ML model artifacts ──────────────────────────────────────────────
# Models are large binaries regenerated by train_model.py.
# Run `python train_model.py` after cloning to rebuild them.
models/*.joblib
models/*.pkl
models/*.pt
models/*.bin
# Keep the placeholder and README
!models/.gitkeep
!models/README.md

# ── Generated / temporary outputs ──────────────────────────────────
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
data/*
!data/.gitkeep

# ── OS / IDE ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Testing / coverage ──────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Jupyter ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Compiled extensions ─────────────────────────────────────────────
*.so
*.dylib
